# ---- Core ----
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
WEB_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ---- MongoDB ----
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?appName=Cluster0

# ---- Redis ----
#REDIS_URL=redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379

# ---- JWT ----
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=mc_refresh_token

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=change_me_cloud_name
CLOUDINARY_API_KEY=change_me_api_key
CLOUDINARY_API_SECRET=change_me_api_secret

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_change_me
RAZORPAY_KEY_SECRET=change_me_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=change_me_webhook_secret

# ---- SMTP ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change_me@example.com
SMTP_PASS=change_me_smtp_app_password
SMTP_FROM=no-reply@example.com

# ---- Logging ----
LOG_LEVEL=info

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100


# ---- Google OAuth (Prompt 10 — Admin "Continue with Google") ----
# Leave all three empty to keep the feature fully disabled (default). Create
# an OAuth 2.0 Client ID (type "Web application") in Google Cloud Console,
# add GOOGLE_CALLBACK_URL as an authorized redirect URI, then also flip
# `authentication.googleAdminLoginEnabled` on via the Super Admin
# Configuration page — both the env vars AND the config flag are required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback



# ---- Shiprocket (Prompt 14 — courier/shipment integration) ----
# Leave empty to keep the feature disabled (default) — shipment creation
# reports itself as "temporarily unavailable" until these are set.
#SHIPROCKET_EMAIL=
#SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=change_me_webhook_token

# ---- AWS S3 (Prompt 15 — invoice/label/log storage) ----
# Leave empty to keep S3 disabled (default) — invoice PDFs and shipping
# labels fall back to the existing Cloudinary storage path, and log
# batching/retention jobs safely no-op, until these are set.
#ankan@Administrators-MacBook-Pro ~ % mkdir -p ./s3data/my-local-bucket
#ankan@Administrators-MacBook-Pro ~ % npx s3rver -d ./s3data -p 4568                          
#S3rver listening on ::1:4568
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=S3RVER
AWS_SECRET_ACCESS_KEY=S3RVER
AWS_S3_BUCKET=my-local-bucket
AWS_S3_LOG_RETENTION_DAYS=20

# ---- MinIO container credentials (local dev only) ----
# Read by docker-compose.dev.yml's `minio`/`minio-init` services to set the
# MinIO root user and pre-create AWS_S3_BUCKET above. Keep these IDENTICAL to
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY above — MinIO's root user IS the
# access key/secret the S3 SDK authenticates with, there's no separate
# "IAM user" step like real AWS. Never reuse these values anywhere but a
# local machine.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ---- Super Admin bootstrap (local dev only — read by `npm run seed:super-admin`) ----
# Not read by the running server (no envSchema entry) — only by
# apps/api/src/scripts/seed-super-admin.ts, once, to create the FIRST
# super_admin account (see docs/RUNBOOK.md Step 7). Change the password
# immediately after first login via the account's own profile settings.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@medcommerce.local
SUPER_ADMIN_PASSWORD=ChangeMe123!

# ---- Google Analytics ----
GOOGLE_ANALYTICS_STREAM_ID=change_me_stream_id
GOOGLE_ANALYTICS_MEASUREMENT_ID=G-CHANGEME
