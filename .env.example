# ============================================================================
# LOCAL DEVELOPMENT template for the root `.env` (read by `api`/`worker` via
# `env_file: .env` — see infra/docker/docker-compose.yml and the root
# docker-compose.yml). Copy to `.env` and fill in real values; never commit
# the filled-in file (already gitignored).
#
# This is ONE of three env templates in this repo — use the right one:
#   .env.example             <- this file: local dev (what you're reading)
#   .env.local-qa.example     <- local test of the real PRODUCTION Docker
#                                images (docker-compose.local-qa.yml)
#   .env.production.example  <- real EC2 production deployment
#
# Every variable here is validated at boot by
# packages/shared/src/schemas/env.schema.ts — the process refuses to start
# if a REQUIRED one is missing/malformed. Optional ones default to '' (empty)
# and the corresponding integration self-disables (logs a warning, reports
# itself "not configured") rather than crashing — see each integration's
# `*.client.ts` for the exact self-disable check.
# ============================================================================

# ---- Core ----
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
# WEB_BASE_URL is this project's "frontend URL" — it has no fallback default
# (the app refuses to boot without it, see packages/shared/src/schemas/env.schema.ts),
# so there is no risk of silently shipping a localhost link. Used to build
# every link a customer actually clicks from outside the app itself —
# password-reset emails, email-verification links, the logo URL embedded in
# transactional emails. In production this MUST be the real HTTPS domain
# (e.g. https://www.yourdomain.com) — localhost is for local development only.
WEB_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ---- MongoDB ----
# Always a real MongoDB Atlas cluster — this repo runs no local Mongo
# container for the `medcommerce-local`/local-qa stacks (only
# docker-compose.dev.yml's full local-infra dev stack does, for convenience).
# Get the connection string from Atlas (Database -> Connect -> Drivers) and
# use a dedicated dev database, never production.
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/medcommerce?retryWrites=true&w=majority

# ---- Redis ----
# REQUIRED — BullMQ (invoice/notification/shipment/order-fulfillment workers)
# and API rate-limiting both depend on Redis; there is no optional/disabled
# mode. Point this at wherever your Redis actually runs (a local container,
# an EC2-hosted one, or ElastiCache) — see the deployment guide §A for which
# option fits this project's traffic.
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=mc_refresh_token

# ---- Configuration field encryption ----
# Optional in dev (left blank = admin-saved third-party secrets, e.g. a
# Razorpay/Shiprocket key entered via the Super Admin Configuration UI
# instead of this file, are stored in MongoDB in PLAINTEXT, with a startup
# warning logged). REQUIRED in staging/production if that UI is ever used
# for a real secret. Generate with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# ---- Cloudinary (product/CMS image uploads) ----
CLOUDINARY_CLOUD_NAME=change_me_cloud_name
CLOUDINARY_API_KEY=change_me_api_key
CLOUDINARY_API_SECRET=change_me_api_secret

# ---- Razorpay (payments) ----
# Can also be set via the Super Admin Configuration UI instead of here — DB
# config wins when both are present (see razorpay.client.ts).
RAZORPAY_KEY_ID=rzp_test_change_me
RAZORPAY_KEY_SECRET=change_me_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=change_me_webhook_secret

# ---- SMTP (transactional email — OTP, password reset, order updates) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change_me@example.com
SMTP_PASS=change_me_smtp_app_password
SMTP_FROM=no-reply@example.com

# ---- Logging ----
LOG_LEVEL=info

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---- Google OAuth ("Continue with Google" — admin login + customer sign-in) ----
# Leave all three empty to keep the feature fully disabled (default). Create
# an OAuth 2.0 Client ID (type "Web application") in Google Cloud Console,
# add GOOGLE_CALLBACK_URL as an Authorized redirect URI, then also flip the
# relevant Configuration flag(s) on via the Super Admin Configuration page —
# both the env vars AND the config flag are required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ---- Shiprocket (courier/shipment integration) ----
# Leave empty to keep the feature disabled (default) — shipment creation
# reports itself as "temporarily unavailable" until these are set. Can also
# be set via the Super Admin Configuration UI instead (DB config wins).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_WEBHOOK_TOKEN=

# ---- AWS S3 (invoice PDFs, shipping labels, archived application logs) ----
# Leave empty to keep S3 disabled (default) — invoice/label uploads fall
# back to the existing Cloudinary storage path, and log archival/retention
# jobs safely no-op, until these are set. In staging/production prefer an
# IAM role attached to the EC2 instance over static keys below — see the
# deployment guide §H.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Leave unset for real AWS S3. Only set this to point the S3 SDK at a
# non-AWS S3-compatible endpoint, e.g. MinIO (see the MINIO_* section below)
# for local dev without any AWS account at all. Setting this to a MinIO URL
# does NOT make MINIO_ROOT_USER/PASSWORD "AWS credentials" — they are a
# completely separate, local-only identity; never reuse them as
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY against real AWS.
AWS_S3_ENDPOINT=

# Application logs older than this are deleted from S3 (lifecycle rule +
# app-level sweep). Does NOT apply to invoices/shipping labels/audit records.
AWS_S3_LOG_RETENTION_DAYS=20
# Invoice/shipping-label DOCUMENTS in S3 — separate, longer retention than
# logs above (the DB records that reference them are never deleted).
AWS_S3_DOCUMENT_RETENTION_DAYS=30

# ---- Log rotation / S3 archival worker tuning ----
# Infrastructure/deployment settings, not business configuration — rarely
# need changing from these defaults. See
# packages/shared/src/schemas/env.schema.ts for what each one does.
LOG_TIMEZONE=UTC
LOG_ROTATION_HOURS=6
# Leave blank to use the default local log directory (apps/api/logs inside
# the container / infra/logs for the PM2 bare-VM path).
LOG_DIRECTORY=
LOG_S3_PREFIX=logs/
LOG_S3_ARCHIVAL_ENABLED=true
LOG_ARCHIVAL_WORKER_INTERVAL_MINUTES=15
LOG_MAX_PENDING_ARCHIVES=500
LOG_UPLOAD_RETRY_LIMIT=8
LOG_LOCAL_MAX_RETENTION_DAYS=30
LOG_POOL_STATS_INTERVAL_MINUTES=5
# Fixed, deployment-level tenant code (never trusted from a request) — only
# relevant if this deployment is ever extended into a genuine multi-tenant
# setup; a single storefront can leave this as "default".
TENANT_CODE=default

# ---- MinIO container credentials (local dev only, NOT used in staging/production) ----
# Read by docker-compose.dev.yml's `minio`/`minio-init` services to set the
# MinIO root user and pre-create AWS_S3_BUCKET above, as a free S3-compatible
# stand-in so you don't need a real AWS account for local development. Keep
# these IDENTICAL to AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY above when using
# MinIO — MinIO's root user IS the access key/secret the S3 SDK authenticates
# with, there's no separate "IAM user" step like real AWS. Never reuse these
# values anywhere but a local machine, and never set AWS_S3_ENDPOINT in
# staging/production (real AWS S3 has no endpoint override).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ---- Super Admin bootstrap (local dev only) ----
# NOT read by the running server (no envSchema entry) — only by
# `npm run seed:super-admin` / `apps/api/src/scripts/seed-super-admin.ts`,
# once, to create the FIRST super_admin account. Pass these inline to the
# command instead of leaving them here long-term — see the deployment
# guide §J for the production equivalent. Change the password immediately
# after first login via the account's own profile settings.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@medcommerce.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
