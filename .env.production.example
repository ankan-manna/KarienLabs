# ============================================================================
# PRODUCTION environment template — copy to .env.production and fill in real
# values via your secrets manager (see infra/scripts/README below inline).
# NEVER commit the filled-in file. NEVER reuse staging/test credentials here.
# ============================================================================

# ---- Core ----
NODE_ENV=production
PORT=5000
API_BASE_URL=https://api.medcommerce.example.com
WEB_BASE_URL=https://medcommerce.example.com
CORS_ORIGIN=https://medcommerce.example.com

# ---- MongoDB ----
# Production: Atlas (or self-hosted) replica set, auth required, TLS required.
# Connection string must include a dedicated least-privilege DB user (readWrite
# on the medcommerce DB only — never an admin/root user for the app).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medcommerce?retryWrites=true&w=majority

# ---- Redis ----
# Production Redis should require AUTH and run with persistence (AOF) enabled —
# see infra/docker/docker-compose.prod.yml's redis service for the appendonly flag.
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# ---- JWT ---- (generate with: openssl rand -base64 48 — rotate periodically, see Security Center)
JWT_ACCESS_SECRET=replace_with_openssl_rand_base64_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=mc_refresh_token

# ---- Configuration field encryption (Prompt 24 Part 29) ---- (generate with: openssl rand -base64 32)
# REQUIRED in production if any third-party credential (Razorpay/Cloudinary/
# AWS/SMTP) is ever set via the admin Configuration UI instead of env vars —
# otherwise that secret is stored in MongoDB in plaintext. Rotating this key
# requires re-saving every affected Configuration namespace (old ciphertext
# encrypted under the previous key cannot be decrypted with a new one).
CONFIG_ENCRYPTION_KEY=replace_with_openssl_rand_base64_32

# ---- Cloudinary ---- (production cloud — separate from staging/dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay ---- (LIVE keys — rzp_live_*. Webhook secret must match the
# webhook configured in the Razorpay dashboard for this exact endpoint URL.)
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- SMTP ---- (production transactional email provider, e.g. SES/Postmark/SendGrid SMTP relay)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@medcommerce.example.com

# ---- Logging ----
LOG_LEVEL=info

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---- Backups ---- (used by infra/scripts/backup-mongo.sh)
BACKUP_S3_BUCKET=medcommerce-backups-prod
BACKUP_RETENTION_DAYS=30

# ---- Secrets management ----
# In production, DO NOT ship this file to the server by hand. Prefer one of:
#   - Docker secrets (compose `secrets:` block, mounted at /run/secrets/*)
#   - A vault (AWS Secrets Manager / HashiCorp Vault / Doppler) injecting env
#     vars into the container at deploy time via the CI/CD pipeline
#   - At minimum: this file placed on the host with `chmod 600`, owned by the
#     deploy user only, outside the web root, and never logged.
