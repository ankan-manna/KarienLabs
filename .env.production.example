# ============================================================================
# PRODUCTION environment template — copy to .env.production and fill in real
# values via your secrets manager (see "Secrets management" at the bottom).
# NEVER commit the filled-in file. NEVER reuse staging/test credentials here.
# See docs/BRENTIS_HEALTHCARE_PRODUCTION_DEPLOYMENT_GUIDE.md §H for the full
# variable reference, what each one does, and where to get real values.
# ============================================================================

# ---- Core ----
NODE_ENV=production
PORT=5000
API_BASE_URL=https://api.clientlivedemo.shop
WEB_BASE_URL=https://www.clientlivedemo.shop
CORS_ORIGIN=https://www.clientlivedemo.shop

# ---- MongoDB ----
# MongoDB Atlas (replica set, auth required, TLS required — see deployment
# guide §D). Connection string must include a dedicated least-privilege DB
# user (readWrite on the medcommerce DB only — never an admin/root user).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medcommerce?retryWrites=true&w=majority

# ---- Redis ----
# Self-hosted on the same EC2 instance (docker-compose.prod.yml's `redis`
# service), AUTH required, AOF persistence enabled. REDIS_PASSWORD below is
# read DIRECTLY by docker-compose.prod.yml to set the container's
# `--requirepass` — it MUST exactly match the password embedded in
# REDIS_URL, or the api/worker containers will fail to authenticate.
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---- JWT ---- (generate with: openssl rand -base64 48 — rotate periodically)
JWT_ACCESS_SECRET=replace_with_openssl_rand_base64_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=mc_refresh_token

# ---- Configuration field encryption ---- (generate with: openssl rand -base64 32)
# REQUIRED in production if any third-party credential (Razorpay/Cloudinary/
# AWS/SMTP/Shiprocket) is ever set via the admin Configuration UI instead of
# env vars — otherwise that secret is stored in MongoDB in plaintext.
# Rotating this key requires re-saving every affected Configuration
# namespace (old ciphertext encrypted under the previous key cannot be
# decrypted with a new one).
CONFIG_ENCRYPTION_KEY=replace_with_openssl_rand_base64_32

# ---- Cloudinary ---- (production cloud — separate from staging/dev, see guide §G.1)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay ---- (LIVE keys — rzp_live_*, only available after KYC approval,
# see guide §E. Webhook secret must match the webhook configured in the
# Razorpay dashboard for this exact endpoint URL.)
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- SMTP ---- (production transactional email provider — SES/Postmark/
# SendGrid. NOT Gmail — see guide §G.3 for why.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@clientlivedemo.shop

# ---- Google OAuth ---- ("Continue with Google" — admin + customer login, see guide §G.2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.clientlivedemo.shop/api/v1/auth/google/callback

# ---- Shiprocket ---- (courier/shipment integration, see guide §F)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_WEBHOOK_TOKEN=

# ---- AWS S3 ---- (invoices, shipping labels, archived app logs — see guide §C.8/§H)
# Prefer an IAM role attached to the EC2 instance over static keys — leave
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY empty if you set up a role.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Leave empty in production — only used to point at a non-AWS endpoint (MinIO) for local dev.
AWS_S3_ENDPOINT=
AWS_S3_LOG_RETENTION_DAYS=20
AWS_S3_DOCUMENT_RETENTION_DAYS=30

# ---- Log rotation / S3 archival worker tuning ---- (defaults are fine for most deployments)
LOG_TIMEZONE=UTC
LOG_ROTATION_HOURS=6
LOG_DIRECTORY=
LOG_S3_PREFIX=logs/
LOG_S3_ARCHIVAL_ENABLED=true
LOG_ARCHIVAL_WORKER_INTERVAL_MINUTES=15
LOG_MAX_PENDING_ARCHIVES=500
LOG_UPLOAD_RETRY_LIMIT=8
LOG_LOCAL_MAX_RETENTION_DAYS=30
LOG_POOL_STATS_INTERVAL_MINUTES=5
TENANT_CODE=default

# ---- Logging ----
LOG_LEVEL=info

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---- Backups ---- (used by infra/scripts/backup-mongo.sh)
BACKUP_S3_BUCKET=brentis-healthcare-prod
BACKUP_RETENTION_DAYS=30

# ---- Frontend build-time variables ----
# NOT read from this file — Vite inlines these into the static bundle at
# `docker compose build` time via build args (see
# docker-compose.prod.yml's `web` service and apps/web/Dockerfile).
# Pass them as shell env vars before building instead, e.g.:
#   VITE_API_BASE_URL=https://api.clientlivedemo.shop/api/v1 \
#   VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX \
#   docker compose -f infra/docker/docker-compose.yml -f infra/docker/docker-compose.prod.yml --env-file .env.production build web

# ---- Secrets management ----
# In production, DO NOT ship this file to the server by hand. Prefer one of:
#   - Docker secrets (compose `secrets:` block, mounted at /run/secrets/*)
#   - A vault (AWS Secrets Manager / HashiCorp Vault / Doppler) injecting env
#     vars into the container at deploy time via a CI/CD pipeline
#   - At minimum: this file placed on the host with `chmod 600`, owned by the
#     deploy user only, outside the web root, and never logged.
