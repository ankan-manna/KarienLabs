# ============================================================================
# Local "production build" QA template — for
# infra/docker/docker-compose.local-qa.yml ONLY (see that file's header
# comment). Copy to .env.local-qa (gitignored) and fill in:
#
#   cp .env.local-qa.example .env.local-qa
#
# This is NOT the file used by the day-to-day dev stack (that's the root
# .env — see .env.example) and NOT a real production env file (see
# .env.production.example) — it exists purely so you can build and run the
# REAL production Docker images locally before ever touching EC2. Every
# third-party integration below is intentionally left blank: the local-qa
# stack only needs Mongo + Redis + a JWT secret to boot and serve traffic;
# Razorpay/Cloudinary/Shiprocket/Google/SMTP all self-disable when unset
# (see packages/shared/src/schemas/env.schema.ts) rather than crashing.
# ============================================================================

NODE_ENV=production
PORT=5000
API_BASE_URL=http://localhost:8088
WEB_BASE_URL=http://localhost:8088
CORS_ORIGIN=http://localhost:8088

# Throwaway local Mongo started by docker-compose.local-qa.yml itself — NOT
# Atlas. To actually test against Atlas instead, replace this with your real
# `mongodb+srv://...` connection string and remove the `mongo` service from
# docker-compose.local-qa.yml (or just leave it running unused).
MONGO_URI=mongodb://mongo:27017/medcommerce_local_qa

# Local Redis started by docker-compose.local-qa.yml, no password (fine for
# a local-only stack not reachable from outside your machine).
REDIS_URL=redis://redis:6379

# Generate your own — `openssl rand -base64 48` — do not reuse this value
# anywhere real; it only needs to satisfy the 32-char minimum so the app boots.
JWT_ACCESS_SECRET=local_qa_only_replace_with_openssl_rand_base64_48_output
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=mc_refresh_token

# Everything below is optional (self-disabling) — fill in only the
# integrations you actually want to exercise in this local QA run.
CONFIG_ENCRYPTION_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_WEBHOOK_TOKEN=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
