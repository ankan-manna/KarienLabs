# ============================================================================
# STAGING environment template — copy to .env.staging and fill in real values.
# Staging mirrors production topology (replica set, TLS, real Cloudinary/
# Razorpay TEST-mode credentials) so a deploy to staging is a true rehearsal
# of a production deploy. Never commit the filled-in file.
# ============================================================================

# ---- Core ----
NODE_ENV=staging
PORT=5000
API_BASE_URL=https://api.staging.medcommerce.example.com
WEB_BASE_URL=https://staging.medcommerce.example.com
CORS_ORIGIN=https://staging.medcommerce.example.com

# ---- MongoDB ----
# Staging uses its own replica set / Atlas project — never point staging at
# the production cluster (a staging bug must never be able to touch real data).
MONGO_URI=mongodb://mongo:27017/medcommerce_staging?replicaSet=rs0

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- JWT ---- (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=replace_with_openssl_rand_base64_48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=mc_refresh_token

# ---- Configuration field encryption (Prompt 24 Part 29) ---- (generate with: openssl rand -base64 32)
# A DIFFERENT key from production's — see .env.production.example's comment.
CONFIG_ENCRYPTION_KEY=replace_with_openssl_rand_base64_32

# ---- Cloudinary ---- (use a dedicated staging cloud/folder, not production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay ---- (ALWAYS test-mode keys on staging — rzp_test_*)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- SMTP ---- (route to a catch-all/sandbox inbox, e.g. Mailtrap, never real customers)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@staging.medcommerce.example.com

# ---- Logging ----
LOG_LEVEL=debug

# ---- Rate limiting ---- (looser than prod, staging is also used for load-testing)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
