{
  "name": "@medcommerce/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "seed:roles": "tsx src/scripts/seed-roles.ts",
    "seed:super-admin": "tsx src/scripts/seed-super-admin.ts",
    "seed:feature-flags": "tsx src/scripts/seed-feature-flags.ts",
    "seed:dynamic-menu": "tsx src/scripts/seed-dynamic-menu.ts",
    "verify:models": "tsx src/scripts/verify-models.ts",
    "migrate:seller-backfill": "tsx src/scripts/migrate-seller-backfill.ts",
    "migrate:google-id-null": "tsx src/scripts/migrate-google-id-null.ts",
    "migrate:grandfather-verified-users": "tsx src/scripts/migrate-grandfather-verified-users.ts",
    "migrate:demo-content": "tsx src/scripts/migrate-demo-content.ts",
    "test": "tsx --test $(find src -name '*.test.ts' -not -name '*.integration.test.ts')",
    "test:integration": "tsx --test --test-force-exit --test-concurrency=1 $(find src -name '*.integration.test.ts')"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@medcommerce/shared": "*",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.21.2",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^11.0.0",
    "handlebars": "^4.7.8",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.3",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.4",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^23.6.0",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.5",
    "sonic-boom": "^4.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
